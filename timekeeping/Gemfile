# frozen_string_literal: true

source "https://rubygems.org"

ruby "4.0.1"

# Only the Rails frameworks an API over PostgreSQL needs, at the monolith's
# Rails line (root Gemfile), so the service shares no runtime with it but the
# same framework version.
gem "actionpack", "~> 8.1.2"
gem "activerecord", "~> 8.1.2"
gem "activesupport", "~> 8.1.2"
gem "railties", "~> 8.1.2"

gem "jwt", "~> 3.2"
gem "pg", "~> 1.4"
gem "puma", "~> 7.2"

gem "timekeeping_rules", path: "../gems/timekeeping_rules"

group :development, :test do
  gem "rspec-rails", "~> 8.0"
end

# The root Gemfile's pin. Specs stub the monolith's reference endpoint with it,
# and it blocks any real network call a spec would make.
group :test do
  gem "webmock", "~> 3.26.2"
end
