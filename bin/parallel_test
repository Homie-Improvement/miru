#!/usr/bin/env ruby
# frozen_string_literal: true

require "pathname"
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../../Gemfile",
  Pathname.new(__FILE__).realpath)

require "bundler/setup"
require "optparse"

def mise_available?
  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |path|
    File.executable?(File.join(path, "mise"))
  end
end

def runtime_prefix
  mise_available? ? ["mise", "exec", "--"] : []
end

SYSTEM_SPEC_DIRS = ["spec/system", "spec/system_skip"].freeze

options = {
  processes: ENV.fetch("PARALLEL_TEST_PROCESSES", 10),
  setup: false,
  exclude_system: true,
  exclude_dirs: [],
  runtime_log: ENV.fetch("PARALLEL_RUNTIME_LOG", "tmp/parallel_runtime_rspec.log"),
  failures_log: ENV.fetch("PARALLEL_FAILURES_LOG", "tmp/failing_specs.txt")
}

# Directory prefixes ending in "/", so "spec/foo" never also excludes "spec/foo_bar".
def excluded_prefixes(exclude_system:, exclude_dirs:)
  dirs = exclude_system ? SYSTEM_SPEC_DIRS + exclude_dirs : exclude_dirs
  dirs.map { |dir| "#{dir.delete_suffix("/")}/" }.uniq
end

def exclude_pattern(prefixes)
  "^(?:#{prefixes.map { |prefix| Regexp.escape(prefix) }.join("|")})"
end

def spec_files_for(paths, excluded_prefixes:)
  spec_files = if paths.empty?
    Dir["spec/**/*_spec.rb"]
  else
    paths.flat_map do |path|
      File.directory?(path) ? Dir["#{path}/**/*_spec.rb"] : path
    end
  end

  spec_files = spec_files.select { |path| path.end_with?("_spec.rb") }
  return spec_files if excluded_prefixes.empty?

  spec_files.reject { |path| path.start_with?(*excluded_prefixes) }
end

def runtime_log_usable?(runtime_log, spec_files)
  return false unless File.exist?(runtime_log) && !File.zero?(runtime_log)

  runtime_entries = File.readlines(runtime_log, chomp: true).count do |line|
    line.include?("_spec.rb:")
  end

  runtime_entries >= spec_files.count
end

OptionParser.new do |opts|
  opts.banner = "Usage: bin/parallel_test [options] [spec_files]"

  opts.on("-n", "--processes N", Integer, "Number of parallel processes (default: 10)") do |n|
    options[:processes] = n
  end

  opts.on("-s", "--setup", "Setup test databases before running") do
    options[:setup] = true
  end

  opts.on("-e", "--exclude-system", "Exclude system specs") do
    options[:exclude_system] = true
  end

  opts.on("-i", "--include-system", "Include system specs") do
    options[:exclude_system] = false
  end

  opts.on("--exclude-dir PATH", "Exclude a spec directory (repeatable)") do |path|
    options[:exclude_dirs] << path
  end

  opts.on("--runtime-log PATH", "Runtime log file path") do |path|
    options[:runtime_log] = path
  end

  opts.on("--failures-log PATH", "Failures log file path") do |path|
    options[:failures_log] = path
  end

  opts.on("-h", "--help", "Show this help message") do
    puts opts
    exit
  end
end.parse!

# Explicit paths are passed to parallel_rspec as given, with no exclude pattern,
# so an --exclude-dir beside them would be silently ignored.
if ARGV.any? && options[:exclude_dirs].any?
  abort "bin/parallel_test: --exclude-dir only applies when no spec paths are given"
end

# Each parallel process derives its own queue ledger file from TEST_ENV_NUMBER.
# An explicit path would be inherited by every process, so one process's
# suite-start delete would remove the ledger another process is writing.
QUEUE_LEDGER_PATH_KEY = "TIMEKEEPING_QUEUE_LEDGER_PATH"
unless ENV.fetch(QUEUE_LEDGER_PATH_KEY, "").strip.empty?
  abort "bin/parallel_test: unset #{QUEUE_LEDGER_PATH_KEY}; every parallel process would share that one " \
        "queue ledger file, so each process uses its own default file instead"
end

# Set up database for parallel tests if requested
if options[:setup]
  puts "Setting up parallel test databases..."
  setup_env = { "PARALLEL_TEST_PROCESSORS" => options[:processes].to_s }
  setup_ok = system(setup_env, *runtime_prefix, "bin/parallel_setup")
  exit(1) unless setup_ok
end

# Build the command
command = [
  *runtime_prefix, "bundle", "exec", "parallel_rspec",
  "-n", options[:processes].to_s,
  "--runtime-log", options[:runtime_log]
]
parallel_env = {
  "PARALLEL_RUNTIME_LOG" => options[:runtime_log],
  "PARALLEL_FAILURES_LOG" => options[:failures_log],
  # dotenv never replaces a key that is already set, even to "", so this stops a
  # .env or .env.test file from giving every worker the same ledger file again.
  QUEUE_LEDGER_PATH_KEY => ""
}

excluded = excluded_prefixes(exclude_system: options[:exclude_system], exclude_dirs: options[:exclude_dirs])
spec_files = spec_files_for(ARGV, excluded_prefixes: excluded)

if runtime_log_usable?(options[:runtime_log], spec_files)
  command.concat(["--group-by", "runtime"])
elsif File.exist?(options[:runtime_log]) && !File.zero?(options[:runtime_log])
  warn "Ignoring stale parallel runtime log at #{options[:runtime_log]} " \
       "(does not cover #{spec_files.count} spec files)"
end

# Add spec files or directories
if ARGV.empty?
  command << "spec"
  command.concat(["--exclude-pattern", exclude_pattern(excluded)]) unless excluded.empty?
else
  command.concat(ARGV)
end

puts "Running tests with #{options[:processes]} parallel processes..."
puts "Command: #{command.join(" ")}"
# exec replaces this process without flushing Ruby's buffer, so piped output would lose these lines.
$stdout.flush
exec(parallel_env, *command)
